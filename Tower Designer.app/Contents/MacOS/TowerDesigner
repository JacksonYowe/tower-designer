#!/bin/bash
HERE="$(cd "$(dirname "$0")/../../.." && pwd)"
PY="$HOME/.towerdesigner/venv/bin/python"
if [ ! -x "$PY" ]; then
  osascript -e 'display dialog "Tower Designer is not set up yet. Double-click setup.command in the TowerDesigner folder first." buttons {"OK"} with icon caution'
  exit 1
fi
cd "$HERE"
exec "$PY" -m towerdesigner "$@"
